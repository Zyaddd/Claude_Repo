# Required: the password you type in the phone app.
APP_PASSWORD=change-me

# Strongly recommended: Google Places API (New) key -> far more businesses, phones and websites.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=

# Optional: Claude scores each lead 1-10, lists automations to pitch and drafts an opener.
ANTHROPIC_API_KEY=

# Optional
PORT=8080
DATA_DIR=./data
# OSM_CONTACT=you@example.com   # shown to OpenStreetMap's servers, per their usage policy
